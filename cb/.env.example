# ===============================================================
# .env の見本（CB Full 用・読むための見本です）
# ===============================================================
#
# 【.env とは】
#   APIキー・トークンなどの「鍵」を、プログラムの本文から切り離して置くファイル。
#   プロジェクトのフォルダの一番上に「.env」という名前で置く。
#
# 【守ること】
#   1. .env は必ず .gitignore に入れる（GitHub に上げない）
#   2. 鍵の値はチャット（Claude Code を含む）に貼らない。.env に自分で貼り付ける
#   3. 鍵が漏れたかもと思ったら、すぐ各サービスの画面で無効にして作り直す
#   4. この見本の「=」の右側はダミー。本物の鍵を書くのは .env の方だけ（.env.example には書かない）
#
# 【使い方】（.env は自分の手で作る。Claude Code には作らせない）
#   CB3 のセキュリティ設定で、Claude Code は .env と .env.〇〇 を読み書きできなくなっている。
#   鍵を AI に触らせないための設定なので、ここだけは自分で手を動かす。
#   1. この .env.example と、同じフォルダの .gitignore を、自分のプロジェクトの一番上にコピーする
#   2. ターミナルでプロジェクトのフォルダに入り、見本を複製して .env を作る
#        Mac:      cp .env.example .env
#        Windows:  Copy-Item .env.example .env
#   3. Cursor で .env を開き、使うサービスの行だけ「=」の右側を本物の鍵に置き換える（使わない行は消してよい）
#   4. Claude Code には「鍵は .env の SLACK_BOT_TOKEN から読んで」のように、変数の名前だけを伝える
#
# 【先に知っておくこと】
#   CB4 でつなぐ公式の接続（MCP・コネクタ）は、ほとんどがブラウザでログインして許可する方式で、
#   .env は要りません。.env が要るのは、自分でスクリプトを書いて API を直接呼ぶときです。
#   変数の名前は例です。使うツールやライブラリの説明書に名前の指定があれば、そちらに合わせてください。
# ===============================================================


# --- Google（Gmail・Google ドライブ・スプレッドシート共通） ---
# Google は鍵1本ではなく「OAuth クライアント」を作り、ID とシークレットの組で使う。
# 作る場所: Google Cloud コンソール → API とサービス → 認証情報
# 使う API（Gmail API・Google Drive API など）を、同じ画面の「ライブラリ」で有効にしておく。
GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# ダウンロードした JSON ファイルで使う場合は、ファイルの場所だけを書く（JSON の中身は貼らない）
# GOOGLE_OAUTH_CLIENT_FILE=/Users/あなたの名前/secrets/client_secret.json


# --- Notion ---
# 作る場所: Notion の開発者向け設定（内部インテグレーション）→ 新しく作る → シークレットをコピー
# 2024年9月以降に作ったものは ntn_ で始まる（それ以前の secret_ で始まるものもそのまま使える）
# 作っただけでは何も読めない。使うページ側の「接続」でこのインテグレーションを追加する。
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Slack ---
# 作る場所: api.slack.com/apps → アプリを作る → OAuth & Permissions → ワークスペースにインストール
# 「Bot User OAuth Token」（xoxb- で始まる）を使う。必要な権限（スコープ）を足したら入れ直しが要る。
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# 送り先のチャンネル（チャンネル名を右クリック → リンクをコピーした URL の末尾の C から始まる文字列）
SLACK_CHANNEL_ID=C0123456789
